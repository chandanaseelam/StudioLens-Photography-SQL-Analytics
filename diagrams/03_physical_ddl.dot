digraph StudioLensPhysical {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.4", ranksep="1.2", splines=polyline, fontname="Helvetica", label="StudioLens | Physical Database (initial DDL baseline)", labelloc=t, fontsize=20];
node [shape=plain, fontname="Helvetica"];
edge [color="#748695",penwidth=1.2,arrowsize=0.5];
customers [label=<<TABLE BORDER="1" COLOR="#B3C5CC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#165B64" ALIGN="LEFT"><FONT COLOR="white"><B>customers</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">customer_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(12)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">customer_name</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(120)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">email</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(254)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">phone</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(20)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">city</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(80)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">customer_type</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(20)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">signup_date</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">DATE</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR></TABLE>>];
photographers [label=<<TABLE BORDER="1" COLOR="#B3C5CC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#165B64" ALIGN="LEFT"><FONT COLOR="white"><B>photographers</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">photographer_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(12)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">photographer_name</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(120)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">specialty</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(60)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">hire_date</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">DATE</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">employment_type</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(30)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(20)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR></TABLE>>];
packages [label=<<TABLE BORDER="1" COLOR="#B3C5CC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#165B64" ALIGN="LEFT"><FONT COLOR="white"><B>packages</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">package_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(12)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">package_name</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(120)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">category</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(50)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">description</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">list_price</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NUMERIC(12,2)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">duration_hours</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NUMERIC(5,2)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">is_active</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BOOLEAN</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR></TABLE>>];
bookings [label=<<TABLE BORDER="1" COLOR="#B3C5CC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#165B64" ALIGN="LEFT"><FONT COLOR="white"><B>bookings</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">booking_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(12)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">customer_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(12)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">package_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(12)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">created_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">event_start_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">completed_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">booking_status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(20)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">agreed_price</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NUMERIC(12,2)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">discount_amount</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NUMERIC(12,2)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">service_credit_amount</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NUMERIC(12,2)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">notes</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR></TABLE>>];
booking_assignments [label=<<TABLE BORDER="1" COLOR="#B3C5CC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#165B64" ALIGN="LEFT"><FONT COLOR="white"><B>booking_assignments</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">assignment_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(12)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">booking_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(12)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">photographer_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(12)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">assignment_start_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">assignment_end_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">assigned_hours</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NUMERIC(6,2)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">assignment_status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(20)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR></TABLE>>];
invoices [label=<<TABLE BORDER="1" COLOR="#B3C5CC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#165B64" ALIGN="LEFT"><FONT COLOR="white"><B>invoices</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">invoice_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(12)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">booking_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(12)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">issued_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">due_date</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">DATE</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">invoice_amount</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NUMERIC(12,2)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">credit_amount</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NUMERIC(12,2)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">invoice_status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(20)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">currency_code</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">CHAR(3)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR></TABLE>>];
payments [label=<<TABLE BORDER="1" COLOR="#B3C5CC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#165B64" ALIGN="LEFT"><FONT COLOR="white"><B>payments</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">payment_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(12)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">invoice_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(12)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">original_payment_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(12)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">transaction_type</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(20)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">payment_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">amount</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NUMERIC(12,2)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">payment_method</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(30)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(20)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">external_reference</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(80)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR></TABLE>>];
expenses [label=<<TABLE BORDER="1" COLOR="#B3C5CC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#165B64" ALIGN="LEFT"><FONT COLOR="white"><B>expenses</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">expense_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(12)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">booking_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(12)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">expense_date</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">DATE</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">expense_category</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(60)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">cost_type</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(20)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">amount</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NUMERIC(12,2)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">description</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR></TABLE>>];
package_price_history [label=<<TABLE BORDER="1" COLOR="#B3C5CC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#165B64" ALIGN="LEFT"><FONT COLOR="white"><B>package_price_history</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">price_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(12)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">package_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(12)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">effective_from</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">DATE</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">effective_to</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">DATE</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">price</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NUMERIC(12,2)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR></TABLE>>];
cancellations [label=<<TABLE BORDER="1" COLOR="#B3C5CC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#165B64" ALIGN="LEFT"><FONT COLOR="white"><B>cancellations</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">cancellation_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(12)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">booking_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(12)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">cancelled_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">reason_code</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(40)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">reason_details</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">initiated_by</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(20)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR></TABLE>>];
reviews [label=<<TABLE BORDER="1" COLOR="#B3C5CC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#165B64" ALIGN="LEFT"><FONT COLOR="white"><B>reviews</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">review_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(12)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">booking_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(12)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">photographer_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(12)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">feedback_category</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(30)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">rating</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">SMALLINT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">review_text</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">reviewed_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR></TABLE>>];
photographer_availability [label=<<TABLE BORDER="1" COLOR="#B3C5CC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#165B64" ALIGN="LEFT"><FONT COLOR="white"><B>photographer_availability</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">availability_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(12)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">photographer_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(12)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">available_date</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">DATE</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">available_hours</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NUMERIC(5,2)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">availability_type</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR(20)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#667D89" POINT-SIZE="8">-</FONT></TD></TR></TABLE>>];
bookings -> customers [arrowhead=vee];
bookings -> packages [arrowhead=vee];

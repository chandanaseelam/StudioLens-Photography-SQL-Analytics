digraph StudioLens {
graph [rankdir=LR, bgcolor="white", pad="0.28", nodesep="0.55", ranksep="1.2", splines=polyline, fontname="Helvetica"];
node [shape=plain, fontname="Helvetica"];
edge [color="#64748B", penwidth=1.6, arrowsize=0.6];
customers [label=<<TABLE BORDER="1" COLOR="#C4D1D7" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#11636B" ALIGN="LEFT"><FONT COLOR="white"><B>customers</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">customer_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">PK </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">customer_name</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">- </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">email</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">- </FONT></TD></TR></TABLE>>];
photographers [label=<<TABLE BORDER="1" COLOR="#C4D1D7" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#11636B" ALIGN="LEFT"><FONT COLOR="white"><B>photographers</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">photographer_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">PK </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">photographer_name</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">- </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">specialty</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">- </FONT></TD></TR></TABLE>>];
packages [label=<<TABLE BORDER="1" COLOR="#C4D1D7" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#11636B" ALIGN="LEFT"><FONT COLOR="white"><B>packages</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">package_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">PK </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">package_name</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">- </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">category</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">- </FONT></TD></TR></TABLE>>];
bookings [label=<<TABLE BORDER="1" COLOR="#C4D1D7" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#11636B" ALIGN="LEFT"><FONT COLOR="white"><B>bookings</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">booking_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">PK </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">customer_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">FK </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">package_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">FK </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">created_at</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">- </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">event_start_at</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">- </FONT></TD></TR></TABLE>>];
booking_assignments [label=<<TABLE BORDER="1" COLOR="#C4D1D7" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#11636B" ALIGN="LEFT"><FONT COLOR="white"><B>booking_assignments</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">assignment_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">PK </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">booking_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">FK </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">photographer_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">FK </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">assignment_start_at</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">- </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">assignment_end_at</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">- </FONT></TD></TR></TABLE>>];
invoices [label=<<TABLE BORDER="1" COLOR="#C4D1D7" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#11636B" ALIGN="LEFT"><FONT COLOR="white"><B>invoices</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">invoice_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">PK </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">booking_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">FK </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">issued_at</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">- </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">due_date</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">- </FONT></TD></TR></TABLE>>];
payments [label=<<TABLE BORDER="1" COLOR="#C4D1D7" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#11636B" ALIGN="LEFT"><FONT COLOR="white"><B>payments</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">payment_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">PK </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">invoice_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">FK </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">original_payment_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">FK </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">transaction_type</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">- </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">payment_at</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">- </FONT></TD></TR></TABLE>>];
expenses [label=<<TABLE BORDER="1" COLOR="#C4D1D7" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#11636B" ALIGN="LEFT"><FONT COLOR="white"><B>expenses</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">expense_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">PK </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">booking_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">FK </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">expense_date</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">- </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">expense_category</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">- </FONT></TD></TR></TABLE>>];
package_price_history [label=<<TABLE BORDER="1" COLOR="#C4D1D7" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#11636B" ALIGN="LEFT"><FONT COLOR="white"><B>package_price_history</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">price_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">PK </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">package_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">FK </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">effective_from</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">- </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">effective_to</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">- </FONT></TD></TR></TABLE>>];
cancellations [label=<<TABLE BORDER="1" COLOR="#C4D1D7" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#11636B" ALIGN="LEFT"><FONT COLOR="white"><B>cancellations</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">cancellation_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">PK </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">booking_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">FK </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">cancelled_at</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">- </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">reason_code</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">- </FONT></TD></TR></TABLE>>];
reviews [label=<<TABLE BORDER="1" COLOR="#C4D1D7" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#11636B" ALIGN="LEFT"><FONT COLOR="white"><B>reviews</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">review_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">PK </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">booking_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">FK </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">photographer_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">FK </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">feedback_category</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">- </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">rating</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">- </FONT></TD></TR></TABLE>>];
photographer_availability [label=<<TABLE BORDER="1" COLOR="#C4D1D7" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#11636B" ALIGN="LEFT"><FONT COLOR="white"><B>photographer_availability</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">availability_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">PK </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">photographer_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">FK </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">available_date</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">- </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">available_hours</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B" POINT-SIZE="8">- </FONT></TD></TR></TABLE>>];
bookings -> customers [arrowhead=vee, label="customer_id", fontsize=8, fontcolor="#516677"];
bookings -> packages [arrowhead=vee, label="package_id", fontsize=8, fontcolor="#516677"];
booking_assignments -> bookings [arrowhead=vee, label="booking_id", fontsize=8, fontcolor="#516677"];
booking_assignments -> photographers [arrowhead=vee, label="photographer_id", fontsize=8, fontcolor="#516677"];
invoices -> bookings [arrowhead=vee, label="booking_id", fontsize=8, fontcolor="#516677"];
payments -> invoices [arrowhead=vee, label="invoice_id", fontsize=8, fontcolor="#516677"];
payments -> payments [arrowhead=vee, label="original_payment_id", fontsize=8, fontcolor="#516677"];
expenses -> bookings [arrowhead=vee, label="booking_id", fontsize=8, fontcolor="#516677"];
package_price_history -> packages [arrowhead=vee, label="package_id", fontsize=8, fontcolor="#516677"];
cancellations -> bookings [arrowhead=vee, label="booking_id", fontsize=8, fontcolor="#516677"];
reviews -> bookings [arrowhead=vee, label="booking_id", fontsize=8, fontcolor="#516677"];
reviews -> photographers [arrowhead=vee, label="photographer_id", fontsize=8, fontcolor="#516677"];
photographer_availability -> photographers [arrowhead=vee, label="photographer_id", fontsize=8, fontcolor="#516677"];
}